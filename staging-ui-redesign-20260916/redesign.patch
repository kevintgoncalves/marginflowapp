+  --shadow: 0 12px 36px #162c2014;
+}
+.app-shell { grid-template-columns: 260px minmax(0,1fr); }
+.app-shell .workspace { min-width: 0; padding: 32px; gap: 22px; background: var(--bg); }
+.app-shell .sidebar.mf-sidebar { position: sticky; top: 0; height: 100dvh; display: flex; flex-direction: column; width: auto; padding: 24px 18px 16px; gap: 18px; overflow-y: auto; background: var(--surface); border-right: 1px solid var(--line); }
+.mf-sidebar .brand { display: block; min-height: 36px; margin: 0 6px 8px; }
+.mf-sidebar .brand-logo { width: 188px; max-width: 100%; height: auto; }
+.mf-workspace-picker { display: flex; align-items: center; gap: 12px; padding: 12px; border: 1px solid var(--line); border-radius: 12px; }
+.mf-workspace-picker > div { min-width: 0; flex: 1; }
+.mf-workspace-picker strong { display: block; font-size: 13px; overflow-wrap: anywhere; }
+.mf-workspace-picker select { width: 100%; min-height: 28px; padding: 4px 0; font-size: 12px; border: 0; color: var(--muted); background: transparent; }
+.mf-nav-search { display: flex; align-items: center; gap: 8px; padding: 0 12px; border: 1px solid var(--line); border-radius: 22px; }
+.mf-nav-search input { min-width: 0; width: 100%; min-height: 40px; border: 0; background: transparent; padding: 0; box-shadow: none; }
+.mf-sidebar nav { display: grid; order: initial; flex: 0 0 auto; gap: 5px; margin: 0; }
+.mf-sidebar nav button, .mf-sidebar-utilities button { display: flex; width: 100%; min-height: 40px; align-items: center; justify-content: flex-start; gap: 12px; border: 0; border-radius: 9px; padding: 9px 12px; background: transparent; color: var(--text-secondary); font-size: 13px; font-weight: 500; text-align: left; line-height: 1.3; }
+.mf-sidebar nav button svg { width: 18px; height: 18px; }
+.mf-sidebar nav button.active { color: var(--primary); background: var(--mf-green-soft); font-weight: 650; }
+.mf-nav-group { border: 0; }
+.mf-nav-group summary { display: flex; justify-content: space-between; align-items: center; min-height: 42px; gap: 8px; padding: 10px 12px; font-size: 13px; cursor: pointer; color: var(--text); list-style: none; }
+.mf-nav-group summary::-webkit-details-marker { display: none; }
+.mf-nav-group[open] summary svg { transform: rotate(180deg); }
+.mf-nav-group > div { margin-left: 12px; padding-left: 7px; border-left: 1px solid var(--line); }
+.mf-sidebar-utilities { display: grid; gap: 3px; margin-top: auto; padding-top: 18px; border-top: 1px solid var(--line); }
+.mf-sidebar-person { display: flex; align-items: center; gap: 10px; border-top: 1px solid var(--line); padding-top: 16px; }
+.mf-sidebar-person > span:nth-child(2) { flex: 1; min-width: 0; }
+.mf-sidebar-person strong, .mf-sidebar-person small { display: block; font-size: 12px; overflow-wrap: anywhere; }
+.mf-sidebar-person small { color: var(--muted); margin-top: 4px; }
+.mf-sidebar-person button { padding: 7px; background: transparent; color: var(--muted); }
+.mf-avatar { display: grid; place-items: center; flex: 0 0 36px; height: 36px; border-radius: 50%; background: var(--surface-subtle); font-size: 12px; }
+.mf-mobile-header { display: none; }
+.mf-skip-link { position: fixed; top: -100px; left: 16px; z-index: 10000; background: var(--surface); color: var(--primary); padding: 12px; }
+.mf-skip-link:focus { top: 12px; }
+.mf-eyebrow { font-size: 13px; color: var(--muted); margin: 0 0 6px; }
+.topbar h1 { font-size: clamp(27px,2.6vw,36px); letter-spacing: -.035em; color: var(--text); font-weight: 700; }
+.app-shell .topbar { margin-bottom: 2px; min-height: 64px; }
+.app-shell .panel, .mf-rail-section, .settings-summary-card { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; box-shadow: none; }
+.app-shell .panel-head h2, .mf-rail-section h2 { font-size: 18px; letter-spacing: -.025em; }
+.app-shell button, .app-modal button { font-weight: 550; }
+.app-shell button svg, .app-modal button svg { flex: 0 0 auto; }
+.app-shell .page-primary-action { display: inline-flex; align-items: center; justify-content: center; gap: 9px; padding: 10px 16px; min-height: 42px; background: var(--primary); color: var(--surface); border-radius: 10px; }
+.app-shell .page-primary-action svg { position: static; transform: none; margin: 0; flex: 0 0 16px; }
+.app-shell .page-primary-action span { position: static; }
+.app-shell :is(input, select, textarea), .app-modal :is(input, select, textarea) { border-color: var(--line); border-radius: 10px; color: var(--text); }
+.app-shell button.ghost, .app-modal button.ghost { background: var(--surface); border: 1px solid var(--line); color: var(--text); }
+:where(button, a, input, select, textarea, summary):focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }
+.mf-sidebar button:hover, .mf-nav-group summary:hover { background: var(--surface-subtle); }
+.app-shell .table-toolbar > label:not(.invoice-mobile-sort), .search-field, .merge-search { display: flex; align-items: center; gap: 10px; position: relative; }
+.app-shell .table-toolbar > label > svg, .search-field > svg, .merge-search > svg { position: static; inset: auto; transform: none; flex: 0 0 17px; margin: 0; }
+.app-shell .table-toolbar > label > input, .search-field > input, .merge-search > input { min-width: 0; flex: 1; padding-left: 0; }
+.search-field { padding: 0 12px; border: 1px solid var(--line); border-radius: 10px; }
+.search-field > input { border: 0; }
+.table-wrap { max-width: 100%; overflow-x: auto; }
+.app-shell th { background: var(--surface-subtle); color: var(--muted); }
+.app-shell td { border-bottom-color: var(--line); }
+.app-shell .dashboard-content { display: grid; grid-template-columns: minmax(0,1fr) 260px; gap: 24px; align-items: start; }
+.app-shell .dashboard-main-column, .app-shell .dashboard-rail { min-width: 0; display: grid; gap: 20px; }
+.mf-ai-entry { display: flex; width: 100%; min-height: 84px; justify-content: flex-start; gap: 14px; text-align: left; border: 1px solid var(--line); background: var(--surface); color: var(--muted); border-radius: 12px; padding: 18px; }
+.mf-ai-entry > span { flex: 1; }
