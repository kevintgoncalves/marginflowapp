+.app-shell .primary-metrics .metric-card { padding: 20px 16px; background: transparent; border: 0; border-right: 1px solid var(--line); border-radius: 0; min-height: 116px; }
+.app-shell .primary-metrics .metric-card:last-child { border: 0; }
