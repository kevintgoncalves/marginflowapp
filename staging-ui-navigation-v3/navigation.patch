+.mf-settings-heading { grid-column:1/-1; }
+.mf-settings-heading p { color:var(--muted);margin:0 0 6px; }
+.mf-settings-heading h2 { margin:0 0 18px; }
+.settings-section-profile > .settings-profile-section,
+.settings-section-locations > .settings-categories-section,
+.settings-section-targets > .settings-targets-section,
+.settings-section-labour > .settings-labour-section,
