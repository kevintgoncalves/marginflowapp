+.settings-section-parsers > .settings-parsers-section,
+.settings-section-pos > .settings-pos-section,
+.settings-section-templates > .settings-templates-section { display:block; }
+@keyframes mf-settings-reveal { from {opacity:0;transform:translateY(-3px)} to {opacity:1;transform:none} }
+@media(prefers-reduced-motion:reduce) { .mf-settings-tree > div,.mf-settings-branch > div {animation:none} .mf-settings-tree button > svg {transition:none} }
+.mf-sidebar nav { grid-template-columns:minmax(0,1fr); }
+.mf-sidebar .mf-settings-tree, .mf-sidebar .mf-settings-branch { min-width:0; }
+.mf-sidebar .mf-settings-tree button { overflow-wrap:anywhere; }
